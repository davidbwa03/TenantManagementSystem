<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Label above the name box -->
    <TextView
        android:id="@+id/tenantNameLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tenant Name"
        android:textSize="16sp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Box where the user types the tenant's name.
         Width 0dp = "stretch between my left and right constraints" -->
    <EditText
        android:id="@+id/tenantNameEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter tenant name"
        android:minHeight="48dp"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/tenantNameLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Label above the phone box -->
    <TextView
        android:id="@+id/phoneLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Phone Number"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/tenantNameEditText"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Box for the phone number. inputType="phone" shows the number keypad -->
    <EditText
        android:id="@+id/phoneEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter phone number"
        android:inputType="phone"
        android:minHeight="48dp"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/phoneLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Box for the rent paid. It ends where the SAVE button starts.
         inputType="numberDecimal" allows only numbers -->
    <EditText
        android:id="@+id/rentEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter Rent Paid"
        android:inputType="numberDecimal"
        android:minHeight="48dp"
        android:padding="12dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/phoneEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/saveButton" />

    <!-- SAVE button, on the same row as the rent box.
         Its click is wired up in Practical 3 -->
    <Button
        android:id="@+id/saveButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SAVE"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toTopOf="@id/rentEditText"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>